    <style>
        /* Windows XP Luna Blue Theme Variables */
        :root {
            --xp-blue: #3A6EA5; /* Window Title Bar / Active Color */
            --xp-green: #6C9241; /* Start Button Green */
            --xp-dialog-bg: #EBE9D8; /* Standard Dialog Background */
            --xp-input-bg: #FFFFFF;
            --xp-shadow: #7F7F7F;
        }

        body {
            /* XP default background color */
            background-color: #3A6EA5; 
            font-family: 'Tahoma', 'Arial', sans-serif;
            color: #000000;
            padding: 10px;
            min-height: 100vh;
        }

        /* Standard Windows XP Container/Window */
        .xp-window {
            background-color: var(--xp-dialog-bg);
            border-top: 1px solid white;
            border-left: 1px solid white;
            border-right: 1px solid var(--xp-shadow);
            border-bottom: 1px solid var(--xp-shadow);
            margin-bottom: 20px;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.4);
        }

        /* Window Title Bar */
        .xp-title-bar {
            background: linear-gradient(to right, #24589C, #5C94D8);
            color: white;
            padding: 3px 6px;
            font-weight: bold;
            font-size: 0.875rem;
            border-bottom: 1px solid var(--xp-shadow);
        }

        /* XP Button Styling */
        .xp-button {
            background-color: #E6E0DD;
            padding: 3px 12px;
            font-size: 0.8rem;
            font-weight: bold;
            border-top: 1px solid white;
            border-left: 1px solid white;
            border-right: 1px solid #7F7F7F;
            border-bottom: 1px solid #7F7F7F;
            cursor: pointer;
            transition: all 0.1s;
        }

        .xp-button:active {
            border-top: 1px solid #7F7F7F;
            border-left: 1px solid #7F7F7F;
            border-right: 1px solid white;
            border-bottom: 1px solid white;
            box-shadow: inset 1px 1px 1px #000000;
        }

        /* XP Input Field Styling (sunken effect) */
        .xp-input {
            border: 1px solid #7F7F7F;
            background-color: var(--xp-input-bg);
            box-shadow: inset 1px 1px 2px #C2C2C2;
            padding: 2px 4px;
            font-size: 0.9rem;
            color: #333;
        }

        /* XP List/Content Box */
        .xp-content-box {
            border: 1px solid #7F7F7F;
            background-color: white;
            box-shadow: inset 1px 1px 2px #C2C2C2;
            padding: 8px;
        }

        /* File Icon Simulation */
        .xp-icon {
            color: #FF9900; /* Yellow/Orange folder icon color */
            margin-right: 6px;
        }
    </style>
</head>

<body class="p-4 md:p-10">

